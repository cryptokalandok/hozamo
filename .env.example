HOZAMO_EXCHANGE=safetrade
HOZAMO_DNS_RESULT_ORDER=ipv4first
# Leave unset or empty for direct connections.
# HOZAMO_PROXY_URL=https://username:password@proxy.example.com:8443
# Custom SafeTrade pool names for --deposits-by-source (JSON):
# HOZAMO_DEPOSIT_SOURCES='{"My Pool":"prl1...","Other Pool":["prl1...","prl1..."]}'

SAFETRADE_API_KEY=replace-with-a-trading-only-api-key
SAFETRADE_API_SECRET=replace-with-the-api-secret
# SAFETRADE_BASE_URL=https://safe.trade/api/v2

COINEX_API_KEY=replace-with-a-trading-only-access-id
COINEX_API_SECRET=replace-with-the-api-secret-key
# COINEX_BASE_URL=https://api.coinex.com/v2

# Optional shared/provider overrides:
# HOZAMO_BUY_RESERVE_PERCENT=0.5
# HOZAMO_TIMEOUT_MS=15000
# SAFETRADE_TIMEOUT_MS=15000
# COINEX_TIMEOUT_MS=15000
# COINEX_WINDOW_TIME_MS=5000
